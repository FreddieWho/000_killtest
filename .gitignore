# 大体积数据与运行产物：不入库
data/
recovery/
appOptimize/sources/
cci/results/

# benchmarks/ 与 profiles/ 的运行产物不入库，但保留顶层脚本与说明
# （STATUS.md 的「复现汇总」直接引用 benchmarks/*.py）
appOptimize/benchmarks/
!appOptimize/benchmarks/
appOptimize/benchmarks/*
!appOptimize/benchmarks/*.py
appOptimize/profiles/
!appOptimize/profiles/
appOptimize/profiles/*
!appOptimize/profiles/*.md

# 环境、缓存、工具状态
.cache/
.envs/
.deps/
.pi/
__pycache__/
*.pyc
*.log
*.lock

# 杂项
.ipynb_checkpoints/
.DS_Store